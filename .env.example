# Canonical site origin used for sitemap, canonical, and Open Graph URLs.
# On Cloudflare Pages, set this to the custom domain once it is connected.
# SITE_URL=https://example.com

# Cloudflare Web Analytics token. Leave empty to skip the beacon.
# PUBLIC_CF_ANALYTICS_TOKEN=

# Optional endpoint that receives JSON analytics events via sendBeacon.
# PUBLIC_ANALYTICS_ENDPOINT=
