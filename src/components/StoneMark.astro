---
interface Props {
  class?: string;
}
const { class: className = "h-8 w-8" } = Astro.props;
---

<svg class={className} viewBox="0 0 36 36" aria-hidden="true">
  <rect x="1" y="5" width="15" height="9" fill="#4d5b42"></rect>
  <rect x="18" y="3" width="17" height="9" fill="#cbbba4"></rect>
  <rect x="3" y="16" width="18" height="8" fill="#8d4f3c"></rect>
  <rect x="16" y="26" width="18" height="7" fill="#243026"></rect>
</svg>
