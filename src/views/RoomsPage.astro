---
import BookingLink from "../components/BookingLink.astro";
import Gallery from "../components/Gallery.astro";
import Notice from "../components/Notice.astro";
import Base from "../layouts/Base.astro";
import { loadContent } from "../lib/content";
import { t, tList, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const content = await loadContent();
const page = content.pages.rooms as {
  seo: { title: { en: string; he: string }; description: { en: string; he: string } };
  heading: { en: string; he: string };
  intro: { en: string[]; he: string[] };
  families: { heading: { en: string; he: string }; paragraphs: { en: string[]; he: string[] } };
  bedsNote: { en: string; he: string };
  photosHeading: { en: string; he: string };
};
const ui = content.ui as {
  needsConfirmation: { en: string; he: string };
  unpublished: { en: string; he: string };
  fixedBed: { en: string; he: string };
};
const { settings } = content;
---

<Base locale={locale} page="rooms" title={t(locale, page.seo.title)} description={t(locale, page.seo.description)}>
  <header class="mx-auto max-w-6xl px-4 pt-16 pb-6 md:px-6">
    <div class="stone-rule" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <h1 class="mt-6 max-w-3xl font-serif text-4xl text-pine md:text-6xl">{t(locale, page.heading)}</h1>
    <div class="mt-6 grid max-w-3xl gap-4 text-lg text-char">
      {tList(locale, page.intro).map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="mt-4 max-w-3xl text-sm text-char">{t(locale, page.bedsNote)}</p>
  </header>

  <div class="mx-auto grid max-w-6xl gap-4 px-4 pb-8 sm:grid-cols-2 lg:grid-cols-3 md:px-6">
    {
      content.rooms.map((room) =>
        room.published ? (
          <article class="border border-line bg-paper p-5">
            <h2 class="font-serif text-2xl text-pine">{t(locale, room.name)}</h2>
            <p class="mt-1 text-xs tracking-wide text-olive uppercase">{t(locale, ui.fixedBed)}</p>
            <ul class="mt-4 grid gap-2 text-sm">
              {room.beds.map((bed) => (
                <li class="flex justify-between gap-3 border-b border-line/70 py-1">
                  <span>{t(locale, bed.label)}</span>
                  <span class="font-semibold">{bed.count}</span>
                </li>
              ))}
            </ul>
          </article>
        ) : (
          <Notice locale={locale} label={ui.needsConfirmation}>
            <h2 class="font-serif text-2xl text-pine">{t(locale, room.name)}</h2>
            <p class="mt-1 text-xs tracking-wide uppercase">{t(locale, ui.unpublished)}</p>
            {room.note && <p class="mt-3">{t(locale, room.note)}</p>}
          </Notice>
        ),
      )
    }
  </div>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h2 class="font-serif text-4xl text-pine">{t(locale, page.families.heading)}</h2>
    <div class="mt-5 grid max-w-3xl gap-4 text-char">
      {tList(locale, page.families.paragraphs).map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="mt-8">
      <BookingLink locale={locale} settings={settings} ui={content.ui} placement="rooms" intent="availability" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 md:px-6">
    <h2 class="mb-6 font-serif text-3xl text-pine">
      {t(locale, page.photosHeading)}
    </h2>
    <Gallery
      locale={locale}
      ui={content.ui}
      photos={content.photos.filter((photo) => photo.category === "bedroom")}
    />
  </section>
</Base>
