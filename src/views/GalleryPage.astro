---
import Gallery from "../components/Gallery.astro";
import Notice from "../components/Notice.astro";
import Base from "../layouts/Base.astro";
import { loadContent } from "../lib/content";
import { t, tList, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const content = await loadContent();
const page = content.pages.gallery as {
  seo: { title: { en: string; he: string }; description: { en: string; he: string } };
  heading: { en: string; he: string };
  intro: { en: string[]; he: string[] };
};
const ui = content.ui as { needsConfirmation: { en: string; he: string } };
---

<Base locale={locale} page="gallery" title={t(locale, page.seo.title)} description={t(locale, page.seo.description)}>
  <header class="mx-auto max-w-6xl px-4 pt-16 pb-8 md:px-6">
    <div class="stone-rule" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <h1 class="mt-6 max-w-3xl font-serif text-4xl text-pine md:text-6xl">{t(locale, page.heading)}</h1>
    <div class="mt-6 grid max-w-3xl gap-4 text-char">
      {tList(locale, page.intro).map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <Notice locale={locale} label={ui.needsConfirmation} class="mt-8 max-w-3xl">
      <p>{tList(locale, page.intro)[0]}</p>
    </Notice>
  </header>
  <div class="mx-auto max-w-6xl px-4 pb-20 md:px-6">
    <Gallery locale={locale} ui={content.ui} photos={content.photos} />
  </div>
</Base>
